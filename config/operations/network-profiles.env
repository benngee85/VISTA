# Declarative constraints only. Application and CNI support must be validated
# before these values are enforced.
VISTA_NETWORK_PROFILE=satcom-constrained
VISTA_EXPECTED_PATH_MTU=1280
VISTA_EXPECTED_RTT_MIN_MS=350
VISTA_EXPECTED_RTT_MAX_MS=500
VISTA_EXPECTED_PACKET_LOSS_PERCENT=3
VISTA_MINIMUM_LINK_BPS=25000
VISTA_HEARTBEAT_SECONDS=25
VISTA_NETWORK_MAX_CONCURRENCY=1
VISTA_NETWORK_RETRY_LIMIT=3
VISTA_NETWORK_RETRY_BASE_MS=1500
VISTA_NETWORK_COMPRESSION_REQUIRED=true
VISTA_NETWORK_OFFLINE_CACHE_REQUIRED=true
