# syntax=docker/dockerfile:1.7
ARG ROCKY9_IMAGE=quay.io/rockylinux/rockylinux:9.8-minimal@sha256:e1d0a9f5ed99d52e7faf03afe7ee32e48b231c4dd9586808b3d1aedf894dff04

FROM quay.io/rockylinux/rockylinux:9.8-minimal@sha256:e1d0a9f5ed99d52e7faf03afe7ee32e48b231c4dd9586808b3d1aedf894dff04 AS final

ARG ROCKY9_IMAGE
ARG VCS_REF=unknown

LABEL org.opencontainers.image.source="https://github.com/benngee85/VISTA" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.base.name="${ROCKY9_IMAGE}" \
      org.opencontainers.image.title="VISTA Sovereign Entitlement Service"

RUN microdnf -y update && \
    microdnf -y module enable nodejs:24 && \
    microdnf -y install nodejs ca-certificates && \
    microdnf clean all && \
    rm -rf /var/cache/dnf \
           /usr/lib/node_modules/npm \
           /usr/lib/node_modules/corepack \
           /usr/local/lib/node_modules/npm \
           /usr/local/lib/node_modules/corepack \
           /usr/bin/npm \
           /usr/bin/npx \
           /usr/bin/corepack \
           /usr/local/bin/npm \
           /usr/local/bin/npx \
           /usr/local/bin/corepack && \
    command -v node >/dev/null && \
    ! command -v npm >/dev/null && \
    ! command -v npx >/dev/null && \
    ! command -v corepack >/dev/null

WORKDIR /app

COPY services/sovereign-entitlements/server.mjs /app/server.mjs

RUN chown -R 0:0 /app && \
    chmod -R g=u /app && \
    chmod -R a-w /app

ENV NODE_ENV=production \
    HOME=/tmp \
    VISTA_ENTITLEMENT_SERVICE_PORT=46124

USER 10001:0

EXPOSE 46124

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:46124/health/ready',{signal:AbortSignal.timeout(4000)}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "/app/server.mjs"]
